# 이 파일을 backend/.env로 복사해 값을 바꿔 쓰세요. (.env는 git에 올라가지 않습니다)
# .env가 없으면 config.py의 시연용 기본값으로 동작합니다.

# DB 접속 정보 (DB_PASSWORD는 docker-compose.yml도 사용. DB를 처음 만들 때만 적용됨)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=library_ai_db

# 시연용 계정 비밀번호 (setup_db.py가 계정을 처음 만들 때만 사용)
DEMO_ADMIN_PASSWORD=change-me
DEMO_LIBRARIAN_PASSWORD=change-me

# 순찰 사진에 RFID 리더값이 없을 때: virtual = 가상 RFID로 채움 / real = 채우지 않고 'RFID 미수신'으로 표시
RFID_MODE=virtual

# 층마다 남길 순찰 횟수. 그 이전의 기록과 사진은 분석이 끝날 때 지웁니다. (0이면 지우지 않음)
PATROL_KEEP_COUNT=2

# HTTPS로 서비스할 때 1 (HTTP에서 켜면 로그인이 유지되지 않음)
COOKIE_SECURE=0
